"""
R-BurstHADS vs BurstHADS — Complete Experimental Analysis
==========================================================
Tests R-BurstHADS across ALL conditions including boundary cases.

SCENARIOS:
  none             -- no hibernation (baseline)
  saturated_early  -- both spot VMs hibernate early (t=90s, t=105s)
  saturated_late   -- both spot VMs hibernate late (40% of makespan)
  poisson_natural  -- Poisson-sampled hibernation using actual lambda values
  single_hib       -- only ONE spot VM hibernates (m5.xlarge only)

TASK COUNTS: 10, 20, 50, 100, 200, 300
DEADLINE FACTORS: 0.5 (boundary), 1.0 (primary), 2.0 (loose)
RUNS: 20 seeds per config
"""

import sys, random, io, contextlib, math
from pathlib import Path
from multiprocessing import Pool, cpu_count

PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

# ── EXPERIMENT PARAMETERS ─────────────────────────────────────────────────────
TASK_COUNTS      = [10, 20, 50, 100, 200, 300]
DEADLINE_FACTORS = [0.5, 1.0, 2.0]
RUNS_PER_CONFIG  = 20
HIB_OFFSET       = 90.0
HIB_GAP          = 15.0
LAMBDA_VALUES    = [0.5, 1.0, 2.0, 5.0, 10.0, 20.0]

ALL_SCENARIOS = ["none", "saturated_early", "saturated_late",
                 "poisson_natural", "single_hib"]

SC_COL = {
    "none":            "#27ae60",
    "saturated_early": "#c0392b",
    "saturated_late":  "#e67e22",
    "poisson_natural": "#2980b9",
    "single_hib":      "#8e44ad",
}
SC_LABEL = {
    "none":            "No Hibernation (baseline)",
    "saturated_early": "Pool Saturation Early (t=90s)",
    "saturated_late":  "Pool Saturation Late (40% makespan)",
    "poisson_natural": "Poisson Natural (AWS lambda rates)",
    "single_hib":      "Single VM Hibernation (m5.xlarge only)",
}


# ── WORKER FUNCTION ───────────────────────────────────────────────────────────
def run_one_config(args):
    config_id, n, df, scenario, extra = args

    import sys, random, io, contextlib, math
    import numpy as np
    from pathlib import Path

    proj = Path(__file__).resolve().parent.parent
    if str(proj) not in sys.path:
        sys.path.insert(0, str(proj))

    from main import (run_simulation, generate_tasks, compute_deadlines,
                      build_vms_rburst, get_expected_makespan)
    from scheduler.burst_hads   import BurstHADS
    from scheduler.r_burst_hads import RBurstHADS

    def run_silent(cls, tasks, gdl, hib_time):
        f = io.StringIO()
        try:
            with contextlib.redirect_stdout(f):
                m = run_simulation(
                    cls, tasks, gdl,
                    hibernation_time=hib_time,
                    vm_builder=build_vms_rburst,
                    hibernate_high_risk=True,
                )
            s = m.summary()
            # Count completed tasks directly from task objects
            all_t = [t for job in m.jobs
                       for stage in job.stages
                       for t in stage.tasks]
            n_total = len(all_t)
            n_comp  = sum(1 for t in all_t if t.completed)
            pct     = n_comp / n_total * 100 if n_total > 0 else 0.0
            return s["makespan"], s["total_cost"], s["deadline_misses"], pct, n_comp
        except Exception:
            return None, None, None, None, None

    def std(lst):
        if len(lst) < 2: return 0.0
        m = sum(lst) / len(lst)
        return math.sqrt(sum((x-m)**2 for x in lst) / len(lst))

    global_deadline, _ = compute_deadlines(n, df, 1)
    expected_mk        = get_expected_makespan(n)

    results = {"burst":  {"mk":[], "co":[], "ms":[], "pct":[]},
               "rburst": {"mk":[], "co":[], "ms":[], "pct":[]}}

    for run in range(RUNS_PER_CONFIG):
        seed   = 999 * config_id + run
        random.seed(seed)
        tasks  = generate_tasks(n)
        np_rng = np.random.default_rng(seed + 10000)

        if scenario == "none":
            hib_time = None

        elif scenario == "saturated_early":
            hib_time = [HIB_OFFSET, HIB_OFFSET + HIB_GAP]

        elif scenario == "saturated_late":
            late     = max(HIB_OFFSET, expected_mk * 0.40)
            hib_time = [late, late + HIB_GAP]

        elif scenario == "poisson_natural":
            lam_m5   = extra.get("lambda_m5", 5.0) / 3600.0
            lam_c5   = 0.03 / 3600.0
            evts     = []
            t = float(np_rng.exponential(1.0 / lam_m5))
            while t < global_deadline:
                evts.append(t)
                t += float(np_rng.exponential(1.0 / lam_m5))
            t = float(np_rng.exponential(1.0 / lam_c5))
            while t < global_deadline:
                evts.append(t)
                t += float(np_rng.exponential(1.0 / lam_c5))
            hib_time = sorted(evts)[:6] if evts else None

        elif scenario == "single_hib":
            hib_time = [HIB_OFFSET]

        elif scenario == "lambda_sweep":
            lam_hr  = extra.get("lambda_val", 5.0)
            lam_sec = lam_hr / 3600.0
            evts    = []
            t = float(np_rng.exponential(1.0 / lam_sec))
            while t < global_deadline:
                evts.append(t)
                t += float(np_rng.exponential(1.0 / lam_sec))
            hib_time = sorted(evts)[:6] if evts else None

        else:
            hib_time = None

        for key, cls in [("burst", BurstHADS), ("rburst", RBurstHADS)]:
            mk, co, ms, pct, _ = run_silent(cls, tasks, global_deadline, hib_time)
            if mk is not None:
                results[key]["mk"].append(mk)
                results[key]["co"].append(co)
                results[key]["ms"].append(ms or 0)
                results[key]["pct"].append(pct)

    def avg(lst): return sum(lst)/len(lst) if lst else 0.0

    return {
        "n": n, "df": df, "scenario": scenario, "extra": extra,
        "burst_co_avg":  avg(results["burst"]["co"]),
        "burst_co_std":  std(results["burst"]["co"]),
        "burst_mk_avg":  avg(results["burst"]["mk"]),
        "burst_mk_std":  std(results["burst"]["mk"]),
        "burst_ms_avg":  avg(results["burst"]["ms"]),
        "burst_pct_avg": avg(results["burst"]["pct"]),
        "burst_pct_std": std(results["burst"]["pct"]),
        "rburst_co_avg": avg(results["rburst"]["co"]),
        "rburst_co_std": std(results["rburst"]["co"]),
        "rburst_mk_avg": avg(results["rburst"]["mk"]),
        "rburst_mk_std": std(results["rburst"]["mk"]),
        "rburst_ms_avg": avg(results["rburst"]["ms"]),
        "rburst_pct_avg": avg(results["rburst"]["pct"]),
        "rburst_pct_std": std(results["rburst"]["pct"]),
    }


# ── METRIC HELPERS ────────────────────────────────────────────────────────────
def cost_red(r):
    bc, dc = r["burst_co_avg"], r["rburst_co_avg"]
    return (bc - dc) / bc * 100 if bc > 0 and dc > 0 else 0.0

def mk_overhead(r):
    bm, dm = r["burst_mk_avg"], r["rburst_mk_avg"]
    return (dm - bm) / bm * 100 if bm > 0 and dm > 0 else 0.0

def sig(r):
    bc, dc, ds = r["burst_co_avg"], r["rburst_co_avg"], r["rburst_co_std"]
    if bc > 0 and ds > 0:
        red = (bc - dc) / bc * 100
        return abs(red / ((ds / bc) * 100))
    return 0.0


# ═══════════════════════════════════════════════════════════════════════════════
if __name__ == "__main__":

    OUTPUT_DIR = PROJECT_ROOT / "experiments" / "plots_complete"
    OUTPUT_DIR.mkdir(exist_ok=True)

    # ── BUILD CONFIG LIST ────────────────────────────────────────────────────
    configs = []
    cid = 0

    # Main: all scenarios, DF=1.0 and DF=2.0
    for df in [1.0, 2.0]:
        for sc in ALL_SCENARIOS:
            for n in TASK_COUNTS:
                cid += 1
                configs.append((cid, n, df, sc, {}))

    # Boundary DF=0.5
    for sc in ["none", "saturated_early", "saturated_late"]:
        for n in TASK_COUNTS:
            cid += 1
            configs.append((cid, n, 0.5, sc, {}))

    # Lambda sweep
    for lam in LAMBDA_VALUES:
        for n in [50, 100, 200]:
            cid += 1
            configs.append((cid, n, 1.0, "lambda_sweep", {"lambda_val": lam}))

    # Poisson with varying lambda
    for lam in LAMBDA_VALUES:
        for n in TASK_COUNTS:
            cid += 1
            configs.append((cid, n, 1.0, "poisson_natural", {"lambda_m5": lam}))

    n_workers = min(18, cpu_count())
    print(f"Running {len(configs)} configs x {RUNS_PER_CONFIG} runs "
          f"across {n_workers} cores...")

    with Pool(processes=n_workers) as pool:
        raw = pool.map(run_one_config, configs)

    print(f"Done. Generating graphs...\n")

    def get(scenario, df, n=None, lam5=None, lam_val=None):
        out = [r for r in raw
               if r["scenario"] == scenario and r["df"] == df]
        if n is not None:
            out = [r for r in out if r["n"] == n]
        if lam5 is not None:
            out = [r for r in out
                   if abs(r["extra"].get("lambda_m5", -99) - lam5) < 0.01]
        if lam_val is not None:
            out = [r for r in out
                   if abs(r["extra"].get("lambda_val", -99) - lam_val) < 0.01]
        return sorted(out, key=lambda r: r["n"])

    plt.rcParams.update({
        "font.family": "sans-serif", "font.size": 11,
        "axes.titlesize": 11, "axes.labelsize": 11,
        "legend.fontsize": 9,
        "axes.spines.top": False, "axes.spines.right": False,
    })

    def save(fig, name):
        fig.savefig(OUTPUT_DIR / name, dpi=300, bbox_inches="tight")
        plt.close(fig)
        print(f"  Saved: {name}")

    x    = np.array(TASK_COUNTS)
    xpos = np.arange(len(TASK_COUNTS))

    # ── FIG 1: BASELINE NO HIBERNATION ───────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    for df, col, ls in [(1.0, "#2980b9", "-"), (2.0, "#8e44ad", "--")]:
        d = get("none", df)
        ns = [r["n"] for r in d]
        axes[0].errorbar(ns, [cost_red(r) for r in d],
                         yerr=[(r["rburst_co_std"]/r["burst_co_avg"]*100
                                if r["burst_co_avg"] > 0 else 0) for r in d],
                         marker="o", lw=2, color=col, ls=ls, capsize=4,
                         markersize=7, markeredgecolor="white", markeredgewidth=1.2,
                         label=f"DF={df}")
        axes[1].plot(ns, [mk_overhead(r) for r in d],
                     marker="o", lw=2, color=col, ls=ls,
                     markersize=7, markeredgecolor="white", markeredgewidth=1.2,
                     label=f"DF={df}")
    for ax in axes:
        ax.axhline(0, color="#c0392b", ls="--", lw=2.2, alpha=0.85,
                   label="BurstHADS reference line (0%)")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(fontsize=9)
        ax.set_ylim(-20, 20)
    axes[0].set_ylabel("Cost Reduction % over BurstHADS", fontweight="bold")
    axes[0].set_title("Cost Reduction % — No Hibernation Scenario")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan — No Hibernation")
    plt.suptitle("Fig 1 — No Hibernation Scenario | DF=1.0 and DF=2.0\n"
                 "Red dashed = BurstHADS reference (0%)",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig01_baseline_no_hibernation.png")

    # ── FIG 2: POOL SATURATION EARLY ─────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    for df, col, ls in [(1.0, "#c0392b", "-"), (2.0, "#e67e22", "--")]:
        d = get("saturated_early", df)
        ns = [r["n"] for r in d]
        axes[0].errorbar(ns, [cost_red(r) for r in d],
                         yerr=[(r["rburst_co_std"]/r["burst_co_avg"]*100
                                if r["burst_co_avg"]>0 else 0) for r in d],
                         marker="o", lw=2.5, color=col, ls=ls, capsize=5,
                         markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                         label=f"DF={df}")
        axes[1].plot(ns, [mk_overhead(r) for r in d],
                     marker="o", lw=2.5, color=col, ls=ls,
                     markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                     label=f"DF={df}")
    for ax in axes:
        ax.axhline(0, color="#888", ls="--", lw=1.5, alpha=0.7,
                   label="BurstHADS reference (0%)")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(fontsize=9)
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost Reduction — Pool Saturation (Early)\nPositive = R-BurstHADS cheaper")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan Change\nNegative = R-BurstHADS faster")
    plt.suptitle("Fig 2 — Pool Saturation (Early): Both Spot VMs Hibernate at t=90s\n"
                 "DF=1.0 and DF=2.0 | 20 runs per config",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig02_pool_saturation_early.png")

    # ── FIG 3: ALL SCENARIOS DF=1.0 ──────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 6))
    for sc in ALL_SCENARIOS:
        d = get(sc, 1.0) if sc != "poisson_natural" else get(sc, 1.0, lam5=5.0)
        if not d: continue
        ns   = [r["n"] for r in d]
        stds = [(r["rburst_co_std"]/r["burst_co_avg"]*100
                 if r["burst_co_avg"]>0 else 0) for r in d]
        axes[0].errorbar(ns, [cost_red(r) for r in d], yerr=stds,
                         marker="o", lw=2.2, color=SC_COL[sc], capsize=4,
                         markersize=7, markeredgecolor="white", markeredgewidth=1.2,
                         label=SC_LABEL[sc])
        axes[1].plot(ns, [mk_overhead(r) for r in d],
                     marker="o", lw=2.2, color=SC_COL[sc],
                     markersize=7, markeredgecolor="white", markeredgewidth=1.2,
                     label=SC_LABEL[sc])
    for ax in axes:
        ax.axhline(0, color="#1a1a2e", ls="--", lw=2.2, alpha=0.8,
                   label="BurstHADS reference (0%)")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
    axes[0].set_ylabel("Cost Reduction % over BurstHADS", fontweight="bold")
    axes[0].set_title("Cost Reduction: All Scenarios\nRed dashed = BurstHADS baseline")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan: All Scenarios\nNegative = R-BurstHADS faster")
    handles, labels = axes[0].get_legend_handles_labels()
    fig.legend(handles, labels, loc="lower center", ncol=3, fontsize=8.5,
               bbox_to_anchor=(0.5, -0.08), frameon=True)
    plt.suptitle("Fig 3 — All Scenarios | DF=1.0 | 20 runs per config\n"
                 "Bold dashed line = BurstHADS. Above = R-BurstHADS better.",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig03_all_scenarios_df10.png")

    # ── FIG 4: BOUNDARY DF=0.5 ───────────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    for sc, col, lbl in [("none", "#27ae60", "No Hibernation"),
                          ("saturated_early", "#c0392b", "Pool Saturation Early"),
                          ("saturated_late",  "#e67e22", "Pool Saturation Late")]:
        d = get(sc, 0.5)
        if not d: continue
        ns = [r["n"] for r in d]
        axes[0].plot(ns, [cost_red(r) for r in d], marker="o", lw=2.2,
                     color=col, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=lbl)
        axes[1].plot(ns, [mk_overhead(r) for r in d], marker="o", lw=2.2,
                     color=col, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=lbl)
    for ax in axes:
        ax.axhline(0, color="#888", ls="--", lw=1.5, alpha=0.7,
                   label="BurstHADS reference (0%)")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(fontsize=9)
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost — DF=0.5 (Tight Deadline Boundary)")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan — DF=0.5")
    plt.suptitle("Fig 4 — Boundary Test: DF=0.5 (Tight Deadline)\n"
                 "45s VM startup latency relative to deadline slack",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig04_boundary_df05.png")

    # ── FIG 5: DF COMPARISON ─────────────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    for df, col, ls, lbl in [(0.5, "#e74c3c", ":", "DF=0.5 (tight — boundary)"),
                              (1.0, "#c0392b", "-", "DF=1.0 (primary)"),
                              (2.0, "#2980b9", "--", "DF=2.0 (loose)")]:
        d = get("saturated_early", df)
        if not d: continue
        ns = [r["n"] for r in d]
        axes[0].plot(ns, [cost_red(r) for r in d], marker="o", lw=2.5,
                     color=col, ls=ls, markersize=8, markeredgecolor="white",
                     markeredgewidth=1.5, label=lbl)
        axes[1].plot(ns, [mk_overhead(r) for r in d], marker="o", lw=2.5,
                     color=col, ls=ls, markersize=8, markeredgecolor="white",
                     markeredgewidth=1.5, label=lbl)
    for ax in axes:
        ax.axhline(0, color="#888", ls="--", lw=1.5, alpha=0.6,
                   label="BurstHADS baseline")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(fontsize=9)
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost — All DF Values\nPool Saturation Early")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan — All DF Values")
    plt.suptitle("Fig 5 — Deadline Factor Impact on R-BurstHADS Performance\n"
                 "Pool Saturation Early | DF=0.5 boundary | DF=1.0 primary | DF=2.0 loose",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig05_deadline_factor_comparison.png")

    # ── FIG 6: SINGLE VS FULL SATURATION ─────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    for sc, col, ls, lbl in [("saturated_early", "#c0392b", "-",
                               "Full Saturation (both VMs hibernate)"),
                              ("single_hib", "#8e44ad", "--",
                               "Single VM (m5.xlarge only hibernates)"),
                              ("none", "#27ae60", ":",
                               "No Hibernation (baseline)")]:
        d = get(sc, 1.0)
        if not d: continue
        ns = [r["n"] for r in d]
        axes[0].plot(ns, [cost_red(r) for r in d], marker="o", lw=2.2,
                     color=col, ls=ls, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=lbl)
        axes[1].plot(ns, [mk_overhead(r) for r in d], marker="o", lw=2.2,
                     color=col, ls=ls, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=lbl)
    for ax in axes:
        ax.axhline(0, color="#888", ls="--", lw=1.2, alpha=0.5)
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(fontsize=9)
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost: Partial vs Full Saturation")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan: Partial vs Full Saturation")
    plt.suptitle("Fig 6 — Single-VM vs Full Pool Saturation | DF=1.0\n"
                 "Comparing hibernation of one spot VM vs both",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig06_single_vs_full_saturation.png")

    # ── FIG 7: POISSON NATURAL ────────────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    for df, col, ls in [(1.0, "#2980b9", "-"), (2.0, "#8e44ad", "--")]:
        d = get("poisson_natural", df, lam5=5.0)
        if not d: continue
        ns   = [r["n"] for r in d]
        stds = [(r["rburst_co_std"]/r["burst_co_avg"]*100
                 if r["burst_co_avg"]>0 else 0) for r in d]
        axes[0].errorbar(ns, [cost_red(r) for r in d], yerr=stds,
                         marker="o", lw=2.2, color=col, ls=ls, capsize=4,
                         markersize=7, markeredgecolor="white", markeredgewidth=1.2,
                         label=f"DF={df}")
        axes[1].plot(ns, [mk_overhead(r) for r in d], marker="o", lw=2.2,
                     color=col, ls=ls, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=f"DF={df}")
    for ax in axes:
        ax.axhline(0, color="#888", ls="--", lw=1.5, alpha=0.7,
                   label="BurstHADS baseline (0%)")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(fontsize=9)
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost — Poisson Natural (λ=5/hr)\nStochastic hibernation times")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan — Poisson Natural")
    plt.suptitle("Fig 7 — Poisson Natural Hibernation (λ=5/hr)\n"
                 "Each run: different hibernation times drawn from Exponential distribution",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig07_poisson_natural_lambda5.png")

    # ── FIG 8: LAMBDA SWEEP ───────────────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 6))
    for n_t, col, mk in [(50, "#2980b9", "o"),
                          (100, "#c0392b", "s"),
                          (200, "#27ae60", "^")]:
        reds, mks = [], []
        for lam in LAMBDA_VALUES:
            d = get("lambda_sweep", 1.0, n=n_t, lam_val=lam)
            reds.append(cost_red(d[0]) if d else np.nan)
            mks.append(mk_overhead(d[0]) if d else np.nan)
        axes[0].plot(LAMBDA_VALUES, reds, marker=mk, lw=2.2, color=col,
                     markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                     label=f"n={n_t} tasks")
        axes[1].plot(LAMBDA_VALUES, mks, marker=mk, lw=2.2, color=col,
                     markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                     label=f"n={n_t} tasks")
    for ax in axes:
        ax.axhline(0, color="#888", ls="--", lw=1.5, alpha=0.7,
                   label="BurstHADS baseline")
        ax.axvline(5, color="#e67e22", ls=":", lw=1.5, alpha=0.8,
                   label="Our default λ=5/hr")
        ax.set_xlabel("m5.xlarge Hibernation Rate λ (events/hr)",
                      fontweight="bold")
        ax.legend(fontsize=9); ax.grid(alpha=0.3, ls=":")
        ax.set_xscale("log")
        ax.set_xticks(LAMBDA_VALUES)
        ax.set_xticklabels([str(l) for l in LAMBDA_VALUES])
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost Reduction % vs Hibernation Rate")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan Overhead % vs Hibernation Rate")
    plt.suptitle("Fig 8 — Lambda Sweep: Varying m5.xlarge Hibernation Rate\n"
                 "DF=1.0 | Poisson-sampled",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig08_lambda_sweep.png")

    # ── FIG 9: POISSON LAMBDA FAMILY ─────────────────────────────────────────
    lam_colors = {0.5: "#27ae60", 1.0: "#2ecc71", 2.0: "#f39c12",
                  5.0: "#e67e22", 10.0: "#e74c3c", 20.0: "#c0392b"}
    fig, axes = plt.subplots(1, 2, figsize=(13, 6))
    for lam in LAMBDA_VALUES:
        d = get("poisson_natural", 1.0, lam5=lam)
        if not d: continue
        ns  = [r["n"] for r in d]
        col = lam_colors.get(lam, "#888")
        lw  = 2.5 if lam == 5.0 else 1.8
        axes[0].plot(ns, [cost_red(r) for r in d], marker="o", lw=lw,
                     color=col, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=f"λ={lam}/hr", alpha=0.9)
        axes[1].plot(ns, [mk_overhead(r) for r in d], marker="o", lw=lw,
                     color=col, markersize=7, markeredgecolor="white",
                     markeredgewidth=1.2, label=f"λ={lam}/hr", alpha=0.9)
    for ax in axes:
        ax.axhline(0, color="#1a1a2e", ls="--", lw=2.2, alpha=0.8,
                   label="BurstHADS baseline (0%)")
        ax.set_xticks(TASK_COUNTS); ax.grid(alpha=0.3, ls=":")
        ax.set_xlabel("Number of Tasks", fontweight="bold")
        ax.legend(ncol=2, fontsize=8.5)
    axes[0].set_ylabel("Cost Reduction %", fontweight="bold")
    axes[0].set_title("Cost — All Lambda Values\nHigher λ = more frequent hibernation")
    axes[1].set_ylabel("Makespan Overhead %", fontweight="bold")
    axes[1].set_title("Makespan — All Lambda Values")
    plt.suptitle("Fig 9 — Cost and Makespan vs Hibernation Risk Level\n"
                 "Poisson Natural | DF=1.0 | Bold dashed = BurstHADS reference",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig09_poisson_lambda_family.png")

    # ── FIG 10: ABSOLUTE COST (primary) ──────────────────────────────────────
    fig, ax = plt.subplots(figsize=(11, 6))
    d  = get("saturated_early", 1.0)
    w  = 0.35
    ns_= [r["n"] for r in d]
    xp = np.arange(len(ns_))
    ax.bar(xp-w/2, [r["burst_co_avg"]  for r in d], width=w, color="#a65628",
           alpha=0.85, label="BurstHADS (on-demand fallback)", edgecolor="white",
           yerr=[r["burst_co_std"] for r in d], capsize=4)
    ax.bar(xp+w/2, [r["rburst_co_avg"] for r in d], width=w, color="#2c3e50",
           alpha=0.85, label="R-BurstHADS (preemptive spot)", edgecolor="white",
           yerr=[r["rburst_co_std"] for r in d], capsize=4)
    for i, r in enumerate(d):
        cr = cost_red(r)
        top = max(r["burst_co_avg"], r["rburst_co_avg"]) + \
              max(r["burst_co_std"], r["rburst_co_std"]) + \
              max(r["burst_co_avg"] for r in d) * 0.02
        ax.text(xp[i], top, f"-{cr:.0f}%", ha="center", fontsize=9.5,
                fontweight="bold", color="#27ae60",
                bbox=dict(boxstyle="round,pad=0.2", facecolor="white",
                          edgecolor="#27ae60", alpha=0.85))
    ax.text(0.02, 0.93,
            "BurstHADS: c5.large on-demand  |  $0.085/hr  |  speed=2",
            transform=ax.transAxes, fontsize=9, color="#a65628",
            bbox=dict(boxstyle="round,pad=0.3", facecolor="white",
                      edgecolor="#a65628", alpha=0.9))
    ax.text(0.02, 0.83,
            "R-BurstHADS: c5.xlarge spot  |  $0.061/hr  |  speed=4",
            transform=ax.transAxes, fontsize=9, color="#2c3e50",
            bbox=dict(boxstyle="round,pad=0.3", facecolor="white",
                      edgecolor="#2c3e50", alpha=0.9))
    ax.set_xticks(xp); ax.set_xticklabels([str(n) for n in ns_])
    ax.set_xlabel("Number of Tasks", fontweight="bold")
    ax.set_ylabel("Average Total Cost (USD)", fontweight="bold")
    ax.set_title("Fig 10 — Absolute Cost: BurstHADS vs R-BurstHADS\n"
                 "Pool Saturation Early | DF=1.0 | Error bars = +/-1 SD",
                 fontweight="bold", pad=12)
    ax.legend(framealpha=0.95); ax.grid(axis="y", alpha=0.3, ls=":")
    plt.tight_layout()
    save(fig, "fig10_absolute_cost.png")

    # ── FIG 11: COST-MAKESPAN TRADEOFF ────────────────────────────────────────
    fig, ax = plt.subplots(figsize=(10, 7))
    d    = get("saturated_early", 1.0)
    reds = [cost_red(r) for r in d]
    mks  = [mk_overhead(r) for r in d]
    sigs = [sig(r) for r in d]
    ns_  = [r["n"] for r in d]
    sc_  = ax.scatter(mks, reds, s=[max(30, s*80) for s in sigs],
                      c=reds, cmap="RdYlGn", vmin=20, vmax=60,
                      edgecolors="#333", linewidths=1.2, zorder=3)
    for n_, mk, rd, sg in zip(ns_, mks, reds, sigs):
        ox = -65 if mk < -50 else 8
        ax.annotate(f"n={n_}  (sig={sg:.1f}x)", (mk, rd),
                    textcoords="offset points", xytext=(ox, 6),
                    fontsize=9, color="#222",
                    bbox=dict(boxstyle="round,pad=0.25", facecolor="white",
                              edgecolor="#ccc", alpha=0.9),
                    arrowprops=dict(arrowstyle="-", color="#aaa", lw=0.8))
    ax.axhline(0, color="#888", ls="--", lw=1.2, alpha=0.6)
    ax.axvline(0, color="#888", ls="--", lw=1.2, alpha=0.6)
    plt.colorbar(sc_, ax=ax, label="Cost Reduction %", shrink=0.8)
    ax.set_xlabel("Makespan Overhead % (negative = R-BurstHADS faster)",
                  fontweight="bold")
    ax.set_ylabel("Cost Reduction % (positive = R-BurstHADS cheaper)",
                  fontweight="bold")
    ax.set_title("Fig 11 — Cost-Makespan Tradeoff\n"
                 "Pool Saturation Early | DF=1.0 | Bubble = signal strength",
                 fontweight="bold", pad=12)
    ax.grid(alpha=0.3, ls=":")
    plt.tight_layout()
    save(fig, "fig11_cost_makespan_tradeoff.png")

    # ── FIG 12: COMPLETE HEATMAP ──────────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))
    sc_order = ["saturated_early", "saturated_late",
                "poisson_natural", "single_hib", "none"]
    sc_names = ["Pool Saturation\n(Early)", "Pool Saturation\n(Late)",
                "Poisson Natural\n(λ=5/hr)", "Single VM\nHibernation",
                "No Hibernation\n(baseline)"]
    cost_mat, mk_mat = [], []
    for sc in sc_order:
        rc, rm = [], []
        for n in TASK_COUNTS:
            d = (get(sc, 1.0, n=n, lam5=5.0) if sc == "poisson_natural"
                 else get(sc, 1.0, n=n))
            rc.append(cost_red(d[0]) if d else 0)
            rm.append(mk_overhead(d[0]) if d else 0)
        cost_mat.append(rc)
        mk_mat.append(rm)
    im1 = axes[0].imshow(cost_mat, cmap="RdYlGn", vmin=-20, vmax=60,
                         aspect="auto")
    axes[0].set_xticks(range(len(TASK_COUNTS)))
    axes[0].set_xticklabels([str(n) for n in TASK_COUNTS])
    axes[0].set_yticks(range(len(sc_order)))
    axes[0].set_yticklabels(sc_names, fontsize=9)
    axes[0].set_xlabel("Number of Tasks", fontweight="bold")
    axes[0].set_title("Cost Reduction %\n(green = R-BurstHADS cheaper)",
                      fontweight="bold")
    plt.colorbar(im1, ax=axes[0], shrink=0.8)
    for i in range(len(sc_order)):
        for j in range(len(TASK_COUNTS)):
            v = cost_mat[i][j]
            tc = "white" if abs(v) > 35 else "black"
            axes[0].text(j, i, f"{v:.0f}%", ha="center", va="center",
                         fontsize=9, fontweight="bold", color=tc)
    im2 = axes[1].imshow(mk_mat, cmap="RdYlGn_r", vmin=-100, vmax=50,
                         aspect="auto")
    axes[1].set_xticks(range(len(TASK_COUNTS)))
    axes[1].set_xticklabels([str(n) for n in TASK_COUNTS])
    axes[1].set_yticks(range(len(sc_order)))
    axes[1].set_yticklabels(sc_names, fontsize=9)
    axes[1].set_xlabel("Number of Tasks", fontweight="bold")
    axes[1].set_title("Makespan Overhead %\n(green = R-BurstHADS faster)",
                      fontweight="bold")
    plt.colorbar(im2, ax=axes[1], shrink=0.8)
    for i in range(len(sc_order)):
        for j in range(len(TASK_COUNTS)):
            v = mk_mat[i][j]
            tc = "white" if abs(v) > 50 else "black"
            axes[1].text(j, i, f"{v:.0f}%", ha="center", va="center",
                         fontsize=9, fontweight="bold", color=tc)
    plt.suptitle("Fig 12 — Complete Performance Heatmap | DF=1.0 | 20 runs\n"
                 "All scenarios × all task counts. Green = R-BurstHADS better.",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig12_complete_heatmap.png")

    # ── TASK COMPLETION RATE: reported as text, not a figure ────────────────
    # Every task count in this scenario lands at ~100% completion for both
    # schedulers (see the per-n table printed below). Two flat bars pinned
    # at 100% carry no information a sentence doesn't, so this is reported
    # in the summary table instead of a chart.
    data_sat = get("saturated_early", 1.0)
    ns_  = [r["n"] for r in data_sat]
    xp   = np.arange(len(ns_))
    both_100 = all(r["burst_pct_avg"] >= 99.5 and r["rburst_pct_avg"] >= 99.5
                   for r in data_sat)
    print("Task completion (Pool Saturation Early, DF=1.0): "
          + ("both schedulers complete ~100% of tasks at every task count "
             "(see table below)" if both_100
             else "completion rates differ by task count -- see table below"))

    # ── FIG 14: COST-PER-COMPLETED-TASK (VALID COST COMPARISON) ──────────────
    # Raw cost comparison is invalid when completion rates differ.
    # Cost-per-completed-task is the only apples-to-apples cost metric.
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))

    # Left: cost-per-completed-task vs n
    b_cpt, d_cpt = [], []
    for r in data_sat:
        n_ = r["n"]
        b_comp = max(r["burst_pct_avg"]  / 100 * n_, 0.01)
        d_comp = max(r["rburst_pct_avg"] / 100 * n_, 0.01)
        b_cpt.append(r["burst_co_avg"]  / b_comp * 1000)
        d_cpt.append(r["rburst_co_avg"] / d_comp * 1000)

    axes[0].plot(ns_, b_cpt, marker="o", lw=2.5, color="#c0392b",
                 markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                 label="BurstHADS")
    axes[0].plot(ns_, d_cpt, marker="o", lw=2.5, color="#2c3e50",
                 markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                 label="R-BurstHADS")
    for i, (bc, dc) in enumerate(zip(b_cpt, d_cpt)):
        if bc > 0:
            pct_save = (bc - dc) / bc * 100
            axes[0].annotate(f"-{pct_save:.0f}%",
                             xy=(ns_[i], min(bc, dc)),
                             xytext=(0, -18), textcoords="offset points",
                             ha="center", fontsize=8.5, color="#27ae60",
                             fontweight="bold")
    axes[0].set_xlabel("Number of Tasks", fontweight="bold")
    axes[0].set_ylabel("Cost per Completed Task (USD x 10^-3)", fontweight="bold")
    axes[0].set_title("Cost per Completed Task\n"
                      "Same denominator for both schedulers",
                      fontweight="bold")
    axes[0].legend(); axes[0].grid(alpha=0.3, ls=":")

    # Right: stacked bar showing completed vs failed tasks for BurstHADS
    n_done = [r["burst_pct_avg"] / 100 * r["n"] for r in data_sat]
    n_fail = [r["n"] - nd for r, nd in zip(data_sat, n_done)]
    axes[1].bar(xp, n_done, color="#27ae60", alpha=0.85, label="Completed")
    axes[1].bar(xp, n_fail, bottom=n_done, color="#c0392b", alpha=0.85,
                label="Failed (deadline exceeded)")
    for i, (nd, nf) in enumerate(zip(n_done, n_fail)):
        total = nd + nf
        if total > 0:
            axes[1].text(xp[i], total + 2, f"{nf/total*100:.0f}%\nfail",
                         ha="center", fontsize=8.5, color="#c0392b",
                         fontweight="bold")
    axes[1].set_xticks(xp); axes[1].set_xticklabels([str(n) for n in ns_])
    axes[1].set_xlabel("Number of Tasks"); axes[1].set_ylabel("Number of Tasks")
    axes[1].set_title("BurstHADS Task Outcomes\n"
                      "Red = tasks not completed before deadline",
                      fontweight="bold")
    axes[1].legend(); axes[1].grid(axis="y", alpha=0.3, ls=":")

    plt.suptitle("Fig 14 — Cost per Completed Task and Task Outcomes (BurstHADS)\n"
                 "Pool Saturation | DF=1.0 | 20 runs",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "fig14_cost_per_completed_task.png")

    # ── PRINT SUMMARY TABLES ──────────────────────────────────────────────────
    print("\n" + "="*75)
    print("SATURATED EARLY | DF=1.0 -- SUMMARY")
    print("(completion rate and cost-per-completed-task, both schedulers)")
    print("="*75)
    print(f"{'n':>5} {'Burst%':>8} {'RBurst%':>9} {'B$/task':>9}"
          f" {'D$/task':>9} {'CptSave%':>10} {'MkChg%':>8}")
    print("-"*75)
    for r in get("saturated_early", 1.0):
        n_   = r["n"]
        bp   = r["burst_pct_avg"]
        dp   = r["rburst_pct_avg"]
        bc   = r["burst_co_avg"]  / max(bp/100*n_, 0.01) * 1000
        dc   = r["rburst_co_avg"] / max(dp/100*n_, 0.01) * 1000
        sav  = (bc - dc) / bc * 100 if bc > 0 else 0
        mk   = mk_overhead(r)
        print(f"{n_:>5} {bp:>7.1f}%  {dp:>8.1f}%  "
              f"${bc:>7.3f}m  ${dc:>7.3f}m  "
              f"{sav:>9.1f}%  {mk:>7.1f}%")

    print("\n" + "="*75)
    print("BOUNDARY: DF=0.5 | SATURATED EARLY")
    print("="*75)
    print(f"{'n':>5} {'CostRed%':>9} {'MkChg%':>8} {'Notes':>25}")
    print("-"*50)
    for r in get("saturated_early", 0.5):
        cr = cost_red(r)
        mk = mk_overhead(r)
        note = " <-- R-BurstHADS worse" if cr < 0 else ""
        print(f"{r['n']:>5} {cr:>8.1f}% {mk:>7.1f}%{note}")

    print("\n" + "="*75)
    print("LAMBDA SWEEP: n=100 | DF=1.0")
    print("="*75)
    print(f"{'Lambda/hr':>10} {'CostRed%':>10} {'MkChg%':>9} {'Notes':>25}")
    print("-"*55)
    for lam in LAMBDA_VALUES:
        d = get("lambda_sweep", 1.0, n=100, lam_val=lam)
        if d:
            cr = cost_red(d[0])
            mk = mk_overhead(d[0])
            note = " (our default)" if lam == 5.0 else ""
            print(f"{lam:>8}/hr  {cr:>9.1f}%  {mk:>8.1f}%{note}")

    print(f"\nAll figures saved to: {OUTPUT_DIR}")
    print("Analysis complete.")