"""
paper_figures.py  (corrected)
==============================
Generates four publication-ready figures based on reviewer feedback:

  figA_poisson_model.png          -- motivation: hibernation is real and frequent
  figB_completion_rate.png        -- headline result with Poisson timing caveat
  figC_cost_normalized.png        -- raw vs normalized cost (correct framing)
  figF_lambda_sweep.png           -- operating envelope
  figX_recovery_time.png          -- T_recovery with corrected calculation

Fixes applied vs previous version:
  1. Recovery time bug: now measures from hibernation time, not HIB_OFFSET
  2. Fig E (bucketing bug) removed entirely
  3. Fig D (misleading variance) removed entirely
  4. Poisson timing caveat added to Fig B
  5. import uses RBurstHADS / r_burst_hads

Run from project root: python experiments/paper_figures.py
"""

import sys, io, random, contextlib, math
from pathlib import Path
from multiprocessing import Pool, cpu_count

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

OUTPUT_DIR = Path("experiments") / "paper_figures"

TASK_COUNTS   = [10, 20, 50, 100, 200, 300]
SEEDS         = list(range(20))
LAMBDA_VALUES = [0.5, 1.0, 2.0, 5.0, 10.0, 20.0]
HIB_OFFSET    = 90.0
HIB_GAP       = 15.0

plt.rcParams.update({
    "font.family": "sans-serif", "font.size": 11,
    "axes.titlesize": 12, "axes.labelsize": 11,
    "legend.fontsize": 9.5,
    "axes.spines.top": False, "axes.spines.right": False,
})


# ── WORKER ────────────────────────────────────────────────────────────────────
def worker(args):
    label, cls_name, n, seed, df, hib_times, extra = args

    import sys, io, random, contextlib
    import numpy as np
    from pathlib import Path

    proj_root = Path(__file__).resolve().parent.parent
    if str(proj_root) not in sys.path:
        sys.path.insert(0, str(proj_root))

    from main import (run_simulation, generate_tasks, compute_deadlines,
                      build_vms_rburst, get_expected_makespan)
    from scheduler.burst_hads   import BurstHADS
    from scheduler.r_burst_hads import RBurstHADS

    cls = BurstHADS if cls_name == "BurstHADS" else RBurstHADS

    random.seed(seed)
    tasks = generate_tasks(n)
    gdl, _ = compute_deadlines(n, df)

    # Build Poisson hibernation times if needed
    actual_hib_times = hib_times
    if hib_times == "poisson":
        lam_m5 = extra.get("lambda_m5", 5.0) / 3600.0
        lam_c5 = 0.03 / 3600.0
        rng    = np.random.default_rng(seed + 10000)
        evts   = []
        t = float(rng.exponential(1.0 / lam_m5))
        while t < gdl:
            evts.append(t); t += float(rng.exponential(1.0 / lam_m5))
        t = float(rng.exponential(1.0 / lam_c5))
        while t < gdl:
            evts.append(t); t += float(rng.exponential(1.0 / lam_c5))
        actual_hib_times = sorted(evts)[:6] if evts else None

    f = io.StringIO()
    try:
        with contextlib.redirect_stdout(f):
            m = run_simulation(cls, tasks, gdl,
                               hibernation_time=actual_hib_times,
                               vm_builder=build_vms_rburst,
                               hibernate_high_risk=True)
        s     = m.summary()
        all_t = [t for job in m.jobs for stage in job.stages for t in stage.tasks]
        n_comp = sum(1 for t in all_t if t.completed)
        pct    = n_comp / len(all_t) * 100 if all_t else 0.0

        # ── CORRECTED RECOVERY TIME ───────────────────────────────────────────
        # Definition: time from WHEN HIBERNATION FIRES to when the first
        # rescued task starts executing on a provisioned VM (VM id >= 100).
        #
        # Previous bug: subtracted HIB_OFFSET (90s) hardcoded, but VM100
        # activates at t=45s via work stealing BEFORE hibernation fires.
        # Those early start_times gave negative values.
        #
        # Fix: only count tasks on provisioned VMs whose start_time is
        # AFTER the first hibernation event.
        t_recovery = None
        if cls_name == "RBurstHADS" and actual_hib_times:
            first_hib = min(actual_hib_times)
            prov_starts = []
            for job in m.jobs:
                for stage in job.stages:
                    for t in stage.tasks:
                        if (t.assigned_vm
                                and t.assigned_vm.id >= 100
                                and t.start_time is not None
                                and t.start_time > first_hib):
                            prov_starts.append(t.start_time)
            if prov_starts:
                t_recovery = min(prov_starts) - first_hib

        # Count hibernation events for Poisson model stats
        n_hib = len(actual_hib_times) if actual_hib_times else 0

        return {
            "label": label, "cls": cls_name, "n": n, "seed": seed, "df": df,
            "pct": pct, "cost": s["total_cost"], "makespan": s["makespan"],
            "n_comp": n_comp, "n_total": len(all_t),
            "t_recovery": t_recovery,
            "n_hib": n_hib,
        }
    except Exception as e:
        return {
            "label": label, "cls": cls_name, "n": n, "seed": seed, "df": df,
            "pct": 0.0, "cost": 0.0, "makespan": 0.0,
            "n_comp": 0, "n_total": n,
            "t_recovery": None, "n_hib": 0,
            "error": str(e),
        }


def avg(lst): return sum(lst) / len(lst) if lst else 0.0
def std(lst):
    if len(lst) < 2: return 0.0
    m = avg(lst)
    return math.sqrt(sum((x - m)**2 for x in lst) / len(lst))
def med(lst):
    if not lst: return 0.0
    s = sorted(lst); n = len(s)
    return (s[n//2-1] + s[n//2]) / 2 if n % 2 == 0 else s[n//2]
def iqr(lst):
    if len(lst) < 4: return 0.0
    s = sorted(lst); n = len(s)
    q1 = s[n//4]; q3 = s[3*n//4]
    return q1, q3

def save(fig, name):
    p = OUTPUT_DIR / name
    fig.savefig(p, dpi=300, bbox_inches="tight")
    plt.close(fig)
    print(f"  Saved: {name}")


# ═══════════════════════════════════════════════════════════════════════════════
if __name__ == "__main__":
    OUTPUT_DIR.mkdir(exist_ok=True)

    # ── BUILD JOB LIST ────────────────────────────────────────────────────────
    print("Building job list...")
    jobs = []

    # Saturated + baseline across all n, DF=1.0
    for n in TASK_COUNTS:
        for seed in SEEDS:
            for cls in ["BurstHADS", "RBurstHADS"]:
                jobs.append(("sat_df10", cls, n, seed, 1.0,
                             [HIB_OFFSET, HIB_OFFSET+HIB_GAP], {}))
                jobs.append(("none_df10", cls, n, seed, 1.0, None, {}))

    # Poisson at default lambda (Fig B right)
    for n in TASK_COUNTS:
        for seed in SEEDS:
            for cls in ["BurstHADS", "RBurstHADS"]:
                jobs.append(("poisson_def", cls, n, seed, 1.0,
                             "poisson", {"lambda_m5": 5.0}))

    # Single VM hibernation (for Fig C cost-per-task comparison)
    for n in TASK_COUNTS:
        for seed in SEEDS:
            for cls in ["BurstHADS", "RBurstHADS"]:
                jobs.append(("single_hib", cls, n, seed, 1.0,
                             [HIB_OFFSET], {}))

    # Lambda sweep across all LAMBDA_VALUES, n=100 (Fig F)
    for lam in LAMBDA_VALUES:
        for seed in SEEDS:
            for cls in ["BurstHADS", "RBurstHADS"]:
                jobs.append((f"lam_{lam}", cls, 100, seed, 1.0,
                             "poisson", {"lambda_m5": lam}))

    # Poisson model characterization for Fig A
    # Need counts of hibernation events per run for m5.xlarge and c5.large
    for seed in range(200):   # 200 seeds for clean histogram
        jobs.append(("hib_count_m5", "BurstHADS", 100, seed, 1.0,
                     "poisson", {"lambda_m5": 5.0}))
        jobs.append(("hib_count_low", "BurstHADS", 100, seed, 1.0,
                     "poisson", {"lambda_m5": 0.03}))

    n_workers = min(18, cpu_count())
    print(f"Running {len(jobs)} simulations across {n_workers} cores...")

    with Pool(processes=n_workers) as pool:
        results = pool.map(worker, jobs)

    n_ok   = sum(1 for r in results if "error" not in r)
    n_fail = sum(1 for r in results if "error" in r)
    print(f"Done. {n_ok} successful, {n_fail} failed.\n")

    # ── AGGREGATE HELPER ──────────────────────────────────────────────────────
    def agg(label, cls, n=None, df=None, lam=None):
        rows = [r for r in results
                if r["label"] == label and r["cls"] == cls
                and (n   is None or r["n"]  == n)
                and (df  is None or abs(r["df"] - df) < 0.01)]
        if lam is not None:
            rows = [r for r in rows
                    if abs(r.get("extra", {}).get("lambda_m5", -1) - lam) < 0.01
                    if "extra" in r]
        if not rows: return None
        return {
            "n": rows[0]["n"],
            "pct_avg":  avg([r["pct"]     for r in rows]),
            "pct_std":  std([r["pct"]     for r in rows]),
            "cost_avg": avg([r["cost"]    for r in rows]),
            "cost_std": std([r["cost"]    for r in rows]),
            "mk_avg":   avg([r["makespan"] for r in rows]),
            "mk_std":   std([r["makespan"] for r in rows]),
            "n_total":  rows[0]["n_total"],
            "rows":     rows,
        }

    def cpt(a):
        """Cost per completed task (millidollars)."""
        comp = max(a["pct_avg"] / 100 * a["n_total"], 0.01)
        return a["cost_avg"] / comp * 1000

    # ── FIG A: POISSON MODEL MOTIVATION ──────────────────────────────────────
    # Most important motivating figure. Goes in background/motivation section.
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))

    # Left: histogram of hibernation event counts per run
    m5_counts  = [r["n_hib"] for r in results if r["label"] == "hib_count_m5"]
    c5_counts  = [r["n_hib"] for r in results if r["label"] == "hib_count_low"]

    max_hib = max(max(m5_counts, default=0), 5)
    bins = range(0, max_hib + 2)
    axes[0].hist(m5_counts, bins=bins, color="#c0392b", alpha=0.75,
                 label=f"m5.xlarge (lambda=5/hr)\nmean={avg(m5_counts):.1f} events/run",
                 edgecolor="white")
    axes[0].hist(c5_counts, bins=bins, color="#2980b9", alpha=0.75,
                 label=f"c5.large (lambda=0.03/hr)\nmean={avg(c5_counts):.2f} events/run",
                 edgecolor="white")
    axes[0].set_xlabel("Hibernation Events per Run")
    axes[0].set_ylabel("Frequency (out of 200 runs)")
    axes[0].set_title("Hibernation Event Count per Run (200 runs)",
                      fontweight="bold")
    axes[0].legend(fontsize=9); axes[0].grid(axis="y", alpha=0.3, ls=":")

    # Right: first hibernation time distribution for m5.xlarge
    first_times = []
    for seed in range(200):
        rng = np.random.default_rng(seed + 10000)
        lam = 5.0 / 3600.0
        gdl_100, _ = __import__('main').compute_deadlines(100, 1.0)
        t_first = float(rng.exponential(1.0 / lam))
        if t_first < gdl_100:
            first_times.append(t_first)

    axes[1].hist(first_times, bins=30, color="#c0392b", alpha=0.75, edgecolor="white")
    axes[1].axvline(avg(first_times), color="#c0392b", ls="--", lw=2.2,
                    label=f"Mean = {avg(first_times):.0f}s")
    axes[1].axvline(1.0/( 5.0/3600.0), color="#e67e22", ls=":", lw=2,
                    label=f"1/lambda = {1.0/(5.0/3600.0):.0f}s (expected)")
    axes[1].axvline(HIB_OFFSET, color="#2980b9", ls="--", lw=1.5,
                    label=f"Deterministic injection: {HIB_OFFSET:.0f}s")
    axes[1].set_xlabel("First Hibernation Time (seconds)")
    axes[1].set_ylabel("Frequency (out of 200 runs)")
    axes[1].set_title("m5.xlarge: First Hibernation Time Distribution\n"
                      "Exponential distribution — each run different",
                      fontweight="bold")
    axes[1].legend(fontsize=9); axes[1].grid(axis="y", alpha=0.3, ls=":")

    plt.suptitle("Fig A — Poisson Hibernation Model: Spot VM Interruption Frequency\n"
                 "m5.xlarge vs c5.large, at documented AWS interruption rates",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "figA_poisson_model.png")

    # ── FIG B: COMPLETION RATE (HEADLINE) ────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))

    # Left: deterministic pool saturation (the strong result)
    w    = 0.35
    xpos = np.arange(len(TASK_COUNTS))
    b_sat = [agg("sat_df10", "BurstHADS",  n, 1.0) for n in TASK_COUNTS]
    r_sat = [agg("sat_df10", "RBurstHADS", n, 1.0) for n in TASK_COUNTS]

    b_pct = [a["pct_avg"] for a in b_sat if a]
    r_pct = [a["pct_avg"] for a in r_sat if a]
    b_std = [a["pct_std"] for a in b_sat if a]

    axes[0].bar(xpos-w/2, b_pct, width=w, color="#c0392b", alpha=0.85,
                label="BurstHADS", edgecolor="white", yerr=b_std, capsize=5)
    axes[0].bar(xpos+w/2, r_pct, width=w, color="#27ae60", alpha=0.85,
                label="R-BurstHADS", edgecolor="white")
    for i, bp in enumerate(b_pct):
        axes[0].text(xpos[i]-w/2, bp+2, f"{bp:.0f}%",
                     ha="center", fontsize=9.5, fontweight="bold", color="#c0392b")
    axes[0].axhline(100, color="#27ae60", ls="--", lw=1.5, alpha=0.7,
                    label="100% reference line")
    axes[0].set_xticks(xpos); axes[0].set_xticklabels([str(n) for n in TASK_COUNTS])
    axes[0].set_xlabel("Number of Tasks"); axes[0].set_ylabel("% Tasks Completed")
    axes[0].set_title("Deterministic Pool Saturation\n"
                      "(both spot VMs hibernate at t=90s)", fontweight="bold")
    axes[0].set_ylim(0, 118); axes[0].legend(fontsize=9)
    axes[0].grid(axis="y", alpha=0.3, ls=":")

    # Right: Poisson natural hibernation (with caveat)
    b_poi = [agg("poisson_def", "BurstHADS",  n, 1.0) for n in TASK_COUNTS]
    r_poi = [agg("poisson_def", "RBurstHADS", n, 1.0) for n in TASK_COUNTS]

    bp_pct = [a["pct_avg"] if a else 0 for a in b_poi]
    rp_pct = [a["pct_avg"] if a else 0 for a in r_poi]
    bp_std = [a["pct_std"] if a else 0 for a in b_poi]
    rp_std = [a["pct_std"] if a else 0 for a in r_poi]

    axes[1].errorbar(TASK_COUNTS, bp_pct, yerr=bp_std, marker="o", lw=2.5,
                     color="#c0392b", capsize=4, markersize=8,
                     markeredgecolor="white", label="BurstHADS")
    axes[1].errorbar(TASK_COUNTS, rp_pct, yerr=rp_std, marker="o", lw=2.5,
                     color="#27ae60", capsize=4, markersize=8,
                     markeredgecolor="white", label="R-BurstHADS")
    axes[1].axhline(100, color="#27ae60", ls="--", lw=1.2, alpha=0.5)

    # Caveat annotation — required per reviewer feedback
    axes[1].text(0.05, 0.18,
                 "Note: Higher BurstHADS completion vs left panel\n"
                 "because Poisson hibernation is timing-stochastic.\n"
                 "Late hibernations affect fewer queued tasks.",
                 transform=axes[1].transAxes, fontsize=8.5, color="#555",
                 bbox=dict(boxstyle="round,pad=0.4", facecolor="#fffbe6",
                           edgecolor="#e67e22", alpha=0.95))

    # Flag n=300 D-BurstHADS < 100%
    if rp_pct and rp_pct[-1] < 100:
        axes[1].annotate(f"{rp_pct[-1]:.0f}%*",
                         xy=(TASK_COUNTS[-1], rp_pct[-1]),
                         xytext=(-30, 10), textcoords="offset points",
                         fontsize=9, color="#27ae60", fontweight="bold",
                         arrowprops=dict(arrowstyle="->", color="#27ae60", lw=1))

    axes[1].set_xticks(TASK_COUNTS)
    axes[1].set_xlabel("Number of Tasks"); axes[1].set_ylabel("% Tasks Completed")
    axes[1].set_title("Poisson Natural Hibernation (lambda=5/hr)\n"
                      "Stochastic timing — each run different",
                      fontweight="bold")
    axes[1].set_ylim(50, 115); axes[1].legend(fontsize=9)
    axes[1].grid(alpha=0.3, ls=":")

    plt.suptitle("Fig B — Task Completion Rate: Deterministic vs Stochastic Hibernation",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "figB_completion_rate.png")

    # ── FIG C: RAW VS NORMALIZED COST ────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    w    = 0.35
    xpos = np.arange(len(TASK_COUNTS))

    # Left: raw cost (misleading — show explicitly)
    b_raw = [agg("sat_df10", "BurstHADS",  n, 1.0)["cost_avg"] for n in TASK_COUNTS]
    r_raw = [agg("sat_df10", "RBurstHADS", n, 1.0)["cost_avg"] for n in TASK_COUNTS]

    axes[0].bar(xpos-w/2, b_raw, width=w, color="#c0392b", alpha=0.85,
                label="BurstHADS", edgecolor="white")
    axes[0].bar(xpos+w/2, r_raw, width=w, color="#2c3e50", alpha=0.85,
                label="R-BurstHADS", edgecolor="white")
    axes[0].set_xticks(xpos); axes[0].set_xticklabels([str(n) for n in TASK_COUNTS])
    axes[0].set_xlabel("Number of Tasks"); axes[0].set_ylabel("Total Cost (USD)")
    axes[0].set_title("Raw Total Cost (Not Normalized by Completions)",
                      fontweight="bold")
    axes[0].legend(fontsize=9); axes[0].grid(axis="y", alpha=0.3, ls=":")
    # Completion % annotation -- dark text on a light box so it stays
    # legible whether it lands on a colored bar or the white background.
    ymax_raw = max(max(b_raw), max(r_raw))
    for i, n in enumerate(TASK_COUNTS):
        bp = b_sat[i]["pct_avg"] if b_sat[i] else 0
        axes[0].text(xpos[i]-w/2, b_raw[i] + ymax_raw*0.03, f"{bp:.0f}% complete",
                     ha="center", va="bottom", fontsize=7.5, color="#333",
                     fontweight="bold",
                     bbox=dict(boxstyle="round,pad=0.15", facecolor="white",
                               edgecolor="none", alpha=0.85))

    # Right: cost per completed task (valid comparison)
    b_cpt = []
    r_cpt = []
    for n, bs, rs in zip(TASK_COUNTS, b_sat, r_sat):
        if bs and rs:
            b_comp = max(bs["pct_avg"] / 100 * n, 0.01)
            r_comp = max(rs["pct_avg"] / 100 * n, 0.01)
            b_cpt.append(bs["cost_avg"] / b_comp * 1000)
            r_cpt.append(rs["cost_avg"] / r_comp * 1000)
        else:
            b_cpt.append(0); r_cpt.append(0)

    axes[1].plot(TASK_COUNTS, b_cpt, marker="o", lw=2.5, color="#c0392b",
                 markersize=8, markeredgecolor="white", label="BurstHADS")
    axes[1].plot(TASK_COUNTS, r_cpt, marker="o", lw=2.5, color="#2c3e50",
                 markersize=8, markeredgecolor="white", label="R-BurstHADS")

    for i, (bc, dc) in enumerate(zip(b_cpt, r_cpt)):
        if bc > 0:
            sav = (bc - dc) / bc * 100
            axes[1].annotate(f"-{sav:.0f}%",
                             xy=(TASK_COUNTS[i], dc),
                             xytext=(0, -16), textcoords="offset points",
                             ha="center", fontsize=8.5, color="#27ae60",
                             fontweight="bold")

    axes[1].set_xticks(TASK_COUNTS)
    axes[1].set_xlabel("Number of Tasks")
    axes[1].set_ylabel("Cost per Completed Task (USD x 10^-3)")
    axes[1].set_title("Cost per Completed Task (Normalized by Completions)",
                      fontweight="bold")
    axes[1].legend(fontsize=9); axes[1].grid(alpha=0.3, ls=":")

    plt.suptitle("Fig C — Total Cost: Raw vs Normalized by Completed Tasks\n"
                 "Pool Saturation | DF=1.0",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "figC_cost_normalized.png")

    # ── FIG F: LAMBDA SWEEP — OPERATING ENVELOPE ─────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))

    b_pct_lam = []
    r_pct_lam = []
    b_cst_lam = []
    r_cst_lam = []

    for lam in LAMBDA_VALUES:
        lbl = f"lam_{lam}"
        b_rows = [r for r in results if r["label"]==lbl and r["cls"]=="BurstHADS"]
        r_rows = [r for r in results if r["label"]==lbl and r["cls"]=="RBurstHADS"]
        b_pct_lam.append(avg([r["pct"]  for r in b_rows]) if b_rows else 0)
        r_pct_lam.append(avg([r["pct"]  for r in r_rows]) if r_rows else 0)
        b_cst_lam.append(avg([r["cost"] for r in b_rows]) if b_rows else 0)
        r_cst_lam.append(avg([r["cost"] for r in r_rows]) if r_rows else 0)

    # Left: completion rate vs lambda
    axes[0].plot(LAMBDA_VALUES, b_pct_lam, marker="o", lw=2.5, color="#c0392b",
                 markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                 label="BurstHADS")
    axes[0].plot(LAMBDA_VALUES, r_pct_lam, marker="o", lw=2.5, color="#27ae60",
                 markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                 label="R-BurstHADS")

    for i, (lam, bp) in enumerate(zip(LAMBDA_VALUES, b_pct_lam)):
        axes[0].annotate(f"{bp:.0f}%",
                         xy=(lam, bp), xytext=(0, -16),
                         textcoords="offset points",
                         ha="center", fontsize=8.5, color="#c0392b",
                         fontweight="bold")

    axes[0].axhline(100, color="#27ae60", ls="--", lw=1.5, alpha=0.6)
    axes[0].axvline(5, color="#e67e22", ls=":", lw=1.8, alpha=0.9,
                    label="m5.xlarge real rate (lambda=5/hr)")
    axes[0].fill_between(LAMBDA_VALUES,
                         [min(bp, 50) for bp in b_pct_lam], 0,
                         alpha=0.06, color="#c0392b")
    axes[0].set_xlabel("m5.xlarge Hibernation Rate lambda (events/hr)",
                       fontweight="bold")
    axes[0].set_ylabel("% Tasks Completed")
    axes[0].set_title("Task Completion Rate vs m5.xlarge Hibernation Rate",
                      fontweight="bold")
    axes[0].set_ylim(60, 108)
    axes[0].set_xscale("log")
    axes[0].set_xticks(LAMBDA_VALUES)
    axes[0].set_xticklabels([str(l) for l in LAMBDA_VALUES])
    axes[0].legend(fontsize=9); axes[0].grid(alpha=0.3, ls=":")

    # Right: cost vs lambda — the counterintuitive crossover
    axes[1].plot(LAMBDA_VALUES, b_cst_lam, marker="o", lw=2.5, color="#c0392b",
                 markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                 label="BurstHADS")
    axes[1].plot(LAMBDA_VALUES, r_cst_lam, marker="o", lw=2.5, color="#2c3e50",
                 markersize=8, markeredgecolor="white", markeredgewidth=1.5,
                 label="R-BurstHADS")
    axes[1].axvline(5, color="#e67e22", ls=":", lw=1.8, alpha=0.9,
                    label="m5.xlarge real rate")

    # Find crossover point
    crossover_noted = False
    for i in range(len(LAMBDA_VALUES)-1):
        if (b_cst_lam[i] > r_cst_lam[i]) != (b_cst_lam[i+1] > r_cst_lam[i+1]):
            lam_cross = (LAMBDA_VALUES[i] + LAMBDA_VALUES[i+1]) / 2
            axes[1].annotate("cost ordering flips here",
                             xy=(LAMBDA_VALUES[i+1], b_cst_lam[i+1]),
                             xytext=(LAMBDA_VALUES[i+1]*1.5,
                                     max(b_cst_lam)*0.7),
                             fontsize=8.5, color="#555",
                             arrowprops=dict(arrowstyle="->",
                                             color="#555", lw=1.2),
                             bbox=dict(boxstyle="round,pad=0.3",
                                       facecolor="white",
                                       edgecolor="#555", alpha=0.9))
            crossover_noted = True
            break

    axes[1].set_xlabel("m5.xlarge Hibernation Rate lambda (events/hr)",
                       fontweight="bold")
    axes[1].set_ylabel("Average Total Cost (USD)")
    axes[1].set_title("Average Total Cost vs m5.xlarge Hibernation Rate",
                      fontweight="bold")
    axes[1].set_xscale("log")
    axes[1].set_xticks(LAMBDA_VALUES)
    axes[1].set_xticklabels([str(l) for l in LAMBDA_VALUES])
    axes[1].legend(fontsize=9); axes[1].grid(alpha=0.3, ls=":")

    plt.suptitle("Fig F — Cost and Completion vs m5.xlarge Hibernation Rate\n"
                 "n=100 tasks | Poisson hibernation | 20 seeds per lambda value",
                 fontweight="bold", fontsize=13)
    plt.tight_layout()
    save(fig, "figF_lambda_sweep.png")

    # ── FIG X: RECOVERY TIME (corrected) ─────────────────────────────────────
    rec_rows = [r for r in results
                if r["label"] == "sat_df10"
                and r["cls"]  == "RBurstHADS"
                and r["t_recovery"] is not None
                and r["t_recovery"] > 0]   # exclude negatives if any remain

    if rec_rows:
        rec_times = [r["t_recovery"] for r in rec_rows]
        rec_by_n  = {}
        for r in rec_rows:
            rec_by_n.setdefault(r["n"], []).append(r["t_recovery"])

        fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))

        axes[0].hist(rec_times, bins=25, color="#2980b9", alpha=0.8,
                     edgecolor="white")
        axes[0].axvline(avg(rec_times), color="#c0392b", ls="--", lw=2.2,
                        label=f"Mean = {avg(rec_times):.1f}s")
        axes[0].axvline(45, color="#e67e22", ls=":", lw=2,
                        label="Startup latency = 45s")
        axes[0].set_xlabel("Recovery Time (seconds after hibernation)")
        axes[0].set_ylabel("Frequency")
        axes[0].set_title("T_recovery Distribution\n"
                          "Time from hibernation to first rescued task executing",
                          fontweight="bold")
        axes[0].legend(); axes[0].grid(axis="y", alpha=0.3, ls=":")

        ns_r  = sorted(rec_by_n.keys())
        avg_r = [avg(rec_by_n[n]) for n in ns_r]
        std_r = [std(rec_by_n[n]) for n in ns_r]

        axes[1].errorbar(ns_r, avg_r, yerr=std_r, marker="o", lw=2.5,
                         color="#2980b9", capsize=5, markersize=8,
                         markeredgecolor="white", markeredgewidth=1.5,
                         label="R-BurstHADS T_recovery")
        axes[1].axhline(45, color="#e67e22", ls=":", lw=2,
                        label="Theoretical min: 45s (startup latency)")
        axes[1].set_xlabel("Number of Tasks")
        axes[1].set_ylabel("Average Recovery Time (seconds)")
        axes[1].set_title("Recovery Time vs Workload Size",
                          fontweight="bold")
        axes[1].legend(fontsize=9); axes[1].grid(alpha=0.3, ls=":")
        axes[1].set_xticks(ns_r)

        plt.suptitle("Fig X — Recovery Time After Hibernation (R-BurstHADS)\n"
                     f"Mean T_recovery = {avg(rec_times):.1f}s across all runs",
                     fontweight="bold", fontsize=13)
        plt.tight_layout()
        save(fig, "figX_recovery_time.png")

        print(f"\nRecovery time stats:")
        print(f"  mean = {avg(rec_times):.1f}s")
        print(f"  std  = {std(rec_times):.1f}s")
        print(f"  min  = {min(rec_times):.1f}s")
        print(f"  max  = {max(rec_times):.1f}s")
        print(f"  n valid runs = {len(rec_times)}")
    else:
        print("\nRecovery time: no valid (positive) measurements found.")
        print("All provisioned VM tasks started before hibernation (work stealing).")
        print("This means VM100 was already active and stealing tasks at t=45s,")
        print("so by t=90s there were no tasks left to 'rescue'.")
        print("Consider: T_recovery = 45s by definition (startup latency)")

    # ── FINAL SUMMARY TABLE ───────────────────────────────────────────────────
    print()
    print("=" * 68)
    print("CORRECTED PRIMARY RESULTS: SATURATED EARLY | DF=1.0")
    print("=" * 68)
    print(f"{'n':>5}  {'Burst%':>7}  {'RBurst%':>8}  "
          f"{'B$/task':>8}  {'R$/task':>8}  {'Save%':>7}  {'MkChg%':>8}")
    print("-" * 68)
    for n, bs, rs in zip(TASK_COUNTS, b_sat, r_sat):
        if bs and rs:
            bc = bs["cost_avg"] / max(bs["pct_avg"]/100*n, 0.01) * 1000
            rc = rs["cost_avg"] / max(rs["pct_avg"]/100*n, 0.01) * 1000
            sav = (bc - rc) / bc * 100 if bc > 0 else 0
            mk  = (rs["mk_avg"] - bs["mk_avg"]) / bs["mk_avg"] * 100 if bs["mk_avg"] > 0 else 0
            print(f"{n:>5}  {bs['pct_avg']:>6.1f}%  {rs['pct_avg']:>7.1f}%  "
                  f"${bc:>6.3f}m  ${rc:>6.3f}m  {sav:>6.1f}%  {mk:>7.1f}%")

    print(f"\nAll figures saved to: {OUTPUT_DIR.resolve()}")